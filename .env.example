# Backend
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Keyless local default. Docker Compose starts SearXNG automatically.
VERITY_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=replace-this-for-any-shared-deployment
# Optional alternative: set VERITY_SEARCH_PROVIDER=brave and add this key.
BRAVE_SEARCH_API_KEY=
VERITY_ADDR=:8080
VERITY_DB_PATH=./data/verity.db
# Set for durable hosted storage; when present this takes precedence over SQLite.
VERITY_DATABASE_URL=
VERITY_ALLOWED_ORIGINS=http://localhost:3000
VERITY_CONCURRENCY=1
VERITY_MAX_ACTIVE_RUNS=2
# Optional shared-deployment bearer token. Leave blank for local development.
VERITY_API_TOKEN=
# Leave blank to use the selected provider's built-in estimate (SearXNG 0; Brave 0.005).
VERITY_SEARCH_COST_PER_QUERY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
# Only use this with a trusted frontend deployment; prefer a real identity proxy for multi-user production.
NEXT_PUBLIC_VERITY_API_TOKEN=
